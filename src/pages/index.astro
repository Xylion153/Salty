---
import Layout from '../layouts/Layout.astro';
import MenuPreview from '../components/MenuPreview.astro';

const featuredDishes = [
  {
    name: "Papa's Famous Shrimp & Grits",
    tag: 'Signature Dish',
    img: '/shrimp-grits.png',
    desc: 'Creamy cheddar grits topped with sautéed pink Gulf shrimp, andouille sausage, peppers, and our Low Country seasonings.',
    price: '24.99',
  },
  {
    name: 'Bacon Wrapped Shrimp',
    tag: 'Fan Favorite',
    img: '/bacon-shrimp.png',
    desc: 'Sweet pink shrimp wrapped in hickory smoked bacon, brushed with sweet barbeque sauce. Served with fries and slaw.',
    price: '24.99',
  },
  {
    name: 'Louisiana Gator Tail',
    tag: 'Southern Classic',
    img: '/gatortail.png',
    desc: 'Bite-sized pieces of real gator, marinated, lightly floured and fried, served with our Cajun remoulade.',
    price: '16.99',
  },
  {
    name: 'The Salty Papa Margarita',
    tag: 'Signature Drink',
    img: '/margarita.png',
    desc: 'Premium tequila and orange liqueur with real lime, lemon, and orange juices. On the rocks or frozen.',
    price: '9.99',
  },
];

const galleryImages = [
  { src: '/shrimp-grits.png', alt: "Papa's Famous Shrimp and Grits" },
  { src: '/bacon-shrimp.png', alt: 'Bacon Wrapped Shrimp with fries and slaw' },
  { src: '/poboy.png', alt: "Jumbo Shrimp Po' Boy with hush puppies" },
  { src: '/gatortail.png', alt: 'Louisiana Gator Tail with remoulade' },
  { src: '/margarita.png', alt: 'The Salty Papa Margarita' },
  { src: '/background.png', alt: "Salty Papa's Shrimp House menu spread" },
];
---

<Layout
  title="Home"
  description="Salty Papa's Shrimp House is a family-owned seafood restaurant in Fort Myers, FL serving fresh Gulf shrimp, Cajun seafood, po' boys, and scratch-made Southern comfort food daily. Dine-in, takeout, delivery & pet-friendly patio."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-navy">
    <div class="absolute inset-0">
      <img
        src="/shrimp-grits.png"
        alt="Papa's Famous Shrimp and Grits — fresh Gulf shrimp over creamy cheddar grits"
        class="w-full h-full object-cover opacity-50 scale-105"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/80 to-brand-navy/50"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-28 md:py-44 text-center text-white">
      <p class="text-brand-gold text-sm md:text-base tracking-[0.25em] uppercase font-semibold mb-4 animate-fade-in">
        Family Owned &bull; Fort Myers, FL
      </p>
      <h1 class="font-display text-4xl md:text-6xl font-bold mb-4 animate-fade-in">
        Salty Papa's Shrimp House
      </h1>
      <p class="text-white/80 text-lg md:text-xl mb-2 animate-fade-in">
        Where the Bayou Meets the Beach
      </p>
      <p class="text-white/50 max-w-2xl mx-auto mb-10 animate-fade-in">
        Fort Myers' home for fresh Gulf shrimp, Cajun seafood, and scratch-made Southern comfort food —
        served up by the family, every single day, 11am – 8:30pm.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center animate-fade-in">
        <a href="/menu" class="btn-primary px-8 py-3.5">View Menu</a>
        <a href="https://rebu.delivery" target="_blank" rel="noopener noreferrer" class="btn-teal px-8 py-3.5 cta-pulse">Order Online</a>
        <a href="tel:+12394827272" class="btn-outline px-8 py-3.5">Call Now</a>
      </div>
    </div>
  </section>

  <!-- Why Locals Love Salty Papa's -->
  <section class="py-16 md:py-20 bg-brand-cream">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-on-scroll">
        <p class="text-brand-red font-bold text-xs tracking-[0.3em] uppercase mb-3">Why Fort Myers Keeps Coming Back</p>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-navy">Why Locals Love Salty Papa's</h2>
        <p class="text-gray-500 text-sm mt-3 max-w-2xl mx-auto">
          The go-to seafood restaurant in Fort Myers for fresh Gulf shrimp, Cajun seafood classics,
          and a kitchen that still does things the old-fashioned way.
        </p>
        <div class="divider-teal mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group bg-white rounded-2xl p-7 text-center card-hover animate-on-scroll delay-1">
          <div class="icon-badge w-14 h-14 bg-brand-teal/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.5 2.5 4 5.5 4 8.5a4 4 0 11-8 0c0-3 1.5-6 4-8.5z" />
            </svg>
          </div>
          <h3 class="font-display text-lg font-bold text-brand-navy mb-2">Fresh Gulf Shrimp</h3>
          <p class="text-gray-500 text-sm leading-relaxed">
            Real wild-caught Gulf pink shrimp, sourced from Florida, Texas &amp; Louisiana fishermen.
            Never imported, never frozen-and-forgotten.
          </p>
        </div>

        <div class="group bg-white rounded-2xl p-7 text-center card-hover animate-on-scroll delay-2">
          <div class="icon-badge w-14 h-14 bg-brand-red/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 2.25c-1.5 0-2.25.75-2.25 2.25S7.5 6.75 9 6.75m6-4.5c1.5 0 2.25.75 2.25 2.25S16.5 6.75 15 6.75M4.5 9.75h15M4.5 9.75a2.25 2.25 0 00-2.25 2.25v.75c0 3.864 4.365 7.5 9.75 7.5s9.75-3.636 9.75-7.5v-.75A2.25 2.25 0 0019.5 9.75" />
            </svg>
          </div>
          <h3 class="font-display text-lg font-bold text-brand-navy mb-2">Scratch-Made Recipes</h3>
          <p class="text-gray-500 text-sm leading-relaxed">
            Every sauce, soup, dressing, and dessert is made in-house, from scratch, every single day.
            Nothing frozen or pre-made.
          </p>
        </div>

        <div class="group bg-white rounded-2xl p-7 text-center card-hover animate-on-scroll delay-3">
          <div class="icon-badge w-14 h-14 bg-brand-gold/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.97 0 9-4.03 9-9s-4.03-9-9-9-9 4.03-9 9 4.03 9 9 9z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75c0 .414-.336.75-.75.75s-.75-.336-.75-.75.336-.75.75-.75.75.336.75.75zm6 0c0 .414-.336.75-.75.75s-.75-.336-.75-.75.336-.75.75-.75.75.336.75.75zM8.25 14.25a3.75 3.75 0 007.5 0" />
            </svg>
          </div>
          <h3 class="font-display text-lg font-bold text-brand-navy mb-2">Family Owned &amp; Operated</h3>
          <p class="text-gray-500 text-sm leading-relaxed">
            The owner is on-site every day and our two chefs cook everything to order.
            You're not a ticket number — you're family.
          </p>
        </div>

        <div class="group bg-white rounded-2xl p-7 text-center card-hover animate-on-scroll delay-4">
          <div class="icon-badge w-14 h-14 bg-brand-teal/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-brand-teal" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <h3 class="font-display text-lg font-bold text-brand-navy mb-2">Pet-Friendly Patio</h3>
          <p class="text-gray-500 text-sm leading-relaxed">
            Bring the whole family — including the dog. Our courtyard patio and Pupper Meals menu
            welcome your four-legged friends.
          </p>
        </div>

        <div class="group bg-white rounded-2xl p-7 text-center card-hover animate-on-scroll delay-1">
          <div class="icon-badge w-14 h-14 bg-brand-red/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.5 2.5 4 5.5 4 8.5a4 4 0 11-8 0c0-3 1.5-6 4-8.5z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 21h14M8 21v-3a4 4 0 018 0v3" />
            </svg>
          </div>
          <h3 class="font-display text-lg font-bold text-brand-navy mb-2">Cajun &amp; Southern Flavor</h3>
          <p class="text-gray-500 text-sm leading-relaxed">
            Bold bayou spice meets light, citrus-forward Gulf Coast cooking — true Cajun seafood,
            Fort Myers style.
          </p>
        </div>

        <div class="group bg-white rounded-2xl p-7 text-center card-hover animate-on-scroll delay-2">
          <div class="icon-badge w-14 h-14 bg-brand-gold/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-brand-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="font-display text-lg font-bold text-brand-navy mb-2">Allergy-Friendly Kitchen</h3>
          <p class="text-gray-500 text-sm leading-relaxed">
            Dedicated gluten-free and seafood-only fryers, with a staff trained on every ingredient
            we serve.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The Story -->
  <section class="relative overflow-hidden bg-brand-navy text-white">
    <div class="absolute inset-0">
      <img src="/background.png" alt="" class="w-full h-full object-cover opacity-10" loading="lazy" aria-hidden="true" />
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="text-center mb-12 animate-on-scroll">
        <p class="text-brand-gold font-bold text-xs tracking-[0.3em] uppercase mb-3">The Story</p>
        <h2 class="font-display text-2xl md:text-4xl font-bold">Who Was Salty Papa?</h2>
        <div class="divider-teal mx-auto mt-4"></div>
      </div>

      <div class="space-y-5 text-white/75 leading-relaxed text-base md:text-lg max-w-3xl mx-auto text-center animate-on-scroll">
        <p>
          Long before there was a restaurant, there was just Papa — raised around boatyards and
          docks, where the day's catch came straight off the water and onto the table, no
          shortcuts allowed. He grew up believing a meal was only as good as what went into it,
          and he never let anyone forget it.
        </p>
        <p>
          When his family decided to open a place of their own, they built it around the same
          handful of rules Papa always lived by. Those rules are still the backbone of this
          kitchen today.
        </p>
        <p class="font-display italic text-brand-gold text-lg md:text-xl pt-2">
          "Feed people something real, made with care, and they'll always come back —
          every plate should feel like a celebration."
        </p>
      </div>

      <!-- Polaroid photo trio -->
      <div class="hidden sm:flex justify-center items-end gap-6 mt-14 animate-on-scroll">
        <div class="bg-white p-2.5 pb-4 rounded-lg shadow-xl -rotate-6">
          <img src="/shrimp-grits.png" alt="Papa's Famous Shrimp and Grits" class="w-28 h-28 object-cover rounded" loading="lazy" />
        </div>
        <div class="bg-white p-2.5 pb-4 rounded-lg shadow-xl rotate-2 -translate-y-2">
          <img src="/bacon-shrimp.png" alt="Bacon Wrapped Shrimp" class="w-32 h-32 object-cover rounded" loading="lazy" />
        </div>
        <div class="bg-white p-2.5 pb-4 rounded-lg shadow-xl rotate-6">
          <img src="/gatortail.png" alt="Louisiana Gator Tail" class="w-28 h-28 object-cover rounded" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Dishes -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-on-scroll">
        <p class="text-brand-red font-bold text-xs tracking-[0.3em] uppercase mb-3">From Our Kitchen</p>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-navy">Fan Favorites</h2>
        <div class="divider-teal mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredDishes.map((dish, i) => (
          <div class={`group rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300 bg-white border border-brand-sand animate-on-scroll delay-${i + 1}`}>
            <div class="img-zoom h-44">
              <img src={dish.img} alt={dish.name} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="p-5">
              <p class="text-brand-teal text-[11px] font-bold tracking-wider uppercase mb-1.5">{dish.tag}</p>
              <h3 class="font-display text-base font-bold text-brand-navy mb-1.5 leading-snug group-hover:text-brand-red transition-colors">
                {dish.name}
              </h3>
              <p class="text-gray-400 text-xs leading-relaxed mb-3 line-clamp-3">{dish.desc}</p>
              <p class="text-brand-red font-display font-bold text-lg">${dish.price}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About Salty Papa's -->
  <section class="py-16 md:py-24 bg-brand-cream">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Image grid -->
        <div class="grid grid-cols-2 gap-3 animate-on-scroll">
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <img src="/bacon-shrimp.png" alt="Bacon Wrapped Shrimp" class="w-full h-40 md:h-56 object-cover" loading="lazy" />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg mt-8">
            <img src="/gatortail.png" alt="Louisiana Gator Tail" class="w-full h-40 md:h-56 object-cover" loading="lazy" />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg">
            <img src="/poboy.png" alt="Jumbo Shrimp Po' Boy" class="w-full h-40 md:h-56 object-cover" loading="lazy" />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg mt-8">
            <img src="/margarita.png" alt="The Salty Papa Margarita" class="w-full h-40 md:h-56 object-cover" loading="lazy" />
          </div>
        </div>

        <!-- Text -->
        <div class="animate-on-scroll">
          <p class="text-brand-red font-bold text-xs tracking-[0.3em] uppercase mb-3">A Family Affair</p>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-navy mb-5">
            A Little Slice of the Bayou,<br />Run by Family
          </h2>
          <div class="space-y-4 text-gray-600 leading-relaxed">
            <p>
              Salty Papa's is a true ma-and-pa shop — the owner is on-site every day, our two chefs
              cook everything from scratch, and the whole crew treats every guest like family.
            </p>
            <p>
              We bring you the rich, spicy flavors of the bayou alongside the fresh, light tastes
              of the Gulf Coast — using genuine USA wild-caught shrimp and Florida-sourced
              ingredients. Never imported, never frozen-and-forgotten.
            </p>
            <p>
              Come as you are, bring the family (and the dog — we've got a pet-friendly patio and
              a Pupper Meals menu), and stay for a spell.
            </p>
          </div>
          <div class="divider-gold mt-6 mb-6"></div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
            <div>
              <p class="font-display text-xl font-bold text-brand-navy">100%</p>
              <p class="text-gray-400 text-xs mt-0.5">Scratch-Made</p>
            </div>
            <div>
              <p class="font-display text-xl font-bold text-brand-navy">GF Fryers</p>
              <p class="text-gray-400 text-xs mt-0.5">Allergy Friendly</p>
            </div>
            <div>
              <p class="font-display text-xl font-bold text-brand-navy">Pup Menu</p>
              <p class="text-gray-400 text-xs mt-0.5">Pet-Friendly Patio</p>
            </div>
            <div>
              <p class="font-display text-xl font-bold text-brand-navy">5 Stars</p>
              <p class="text-gray-400 text-xs mt-0.5">Yelp &amp; TripAdvisor</p>
            </div>
          </div>
          <a href="/about" class="inline-block mt-6 text-brand-red font-semibold text-sm hover:text-brand-red-dark transition-colors">
            Read our full story &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Explore the Menu (image cards) -->
  <section class="py-16 md:py-20 bg-brand-warm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-on-scroll">
        <p class="text-brand-red font-bold text-xs tracking-[0.3em] uppercase mb-3">Explore the Menu</p>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-navy">Cajun Seafood, Fort Myers Style</h2>
        <p class="text-gray-400 text-sm mt-3 max-w-xl mx-auto">
          From signature Gulf shrimp dishes to Po' Boys, appetizers, and Papa's famous frozen drinks —
          tap a category to dig in.
        </p>
        <div class="divider-teal mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { name: 'Signature Shrimp Dishes', img: '/shrimp-grits.png', href: '/menu#signature-shrimp-dishes', desc: 'Fresh Gulf pink shrimp, prepared a dozen different ways.' },
          { name: "Po' Boys & Sandwiches", img: '/poboy.png', href: '/menu#po-boys-sandwiches', desc: 'Jumbo Gulf shrimp piled high on toasted bread.' },
          { name: 'Homemade Appetizers', img: '/gatortail.png', href: '/menu#homemade-appetizers', desc: 'Bacon-wrapped shrimp, gator tail, and more scratch-made starters.' },
          { name: "Fresh Shellfish", img: '/bacon-shrimp.png', href: '/menu#fresh-shellfish', desc: 'Oysters, crab, and Gulf shellfish straight off the boat.' },
          { name: "Papa's Signature Drinks", img: '/margarita.png', href: '/menu#papa-s-signature-drinks', desc: 'Frozen margaritas, rum punch, and fresh fruit cocktails.' },
          { name: 'Fresh Salads & Soups', img: '/background.png', href: '/menu#fresh-salads', desc: 'Crisp Gulf Coast salads and from-scratch soups, made daily.' },
        ].map((cat, i) => (
          <a
            href={cat.href}
            class={`group relative rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 h-64 animate-on-scroll delay-${(i % 4) + 1}`}
          >
            <img src={cat.img} alt={cat.name} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/90 via-brand-navy/30 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5 text-white">
              <h3 class="font-display text-xl font-bold mb-1">{cat.name}</h3>
              <p class="text-white/70 text-sm leading-relaxed mb-2">{cat.desc}</p>
              <span class="inline-flex items-center gap-1 text-brand-gold text-sm font-semibold group-hover:gap-2 transition-all">
                View Items &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-10 animate-on-scroll">
        <a href="/menu" class="btn-primary px-8 py-3.5">See the Full Menu</a>
      </div>
    </div>
  </section>

  <!-- Menu Preview -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 animate-on-scroll">
        <p class="text-brand-red font-bold text-xs tracking-[0.3em] uppercase mb-3">Take a Peek</p>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-navy">A Taste of the Menu</h2>
        <p class="text-gray-400 text-sm mt-3 max-w-xl mx-auto">
          Tap a category to see what's inside — from homemade starters to our famous Gulf shrimp.
        </p>
        <div class="divider-teal mx-auto mt-4"></div>
      </div>

      <div class="animate-on-scroll">
        <MenuPreview />
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="bg-brand-sand py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 animate-on-scroll">
        <p class="text-brand-red font-bold text-xs tracking-[0.3em] uppercase mb-3">Y'all Said It</p>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-brand-navy">What People Are Saying</h2>

        <a
          href="https://www.google.com/maps/search/?api=1&query=Salty+Papa%27s+Shrimp+House+Fort+Myers+FL"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-white rounded-full px-6 py-3 mt-6 shadow-sm hover:shadow-md transition-shadow"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.99.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
