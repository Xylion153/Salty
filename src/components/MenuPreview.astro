---
import menuData from '../data/menu.json';

// A hand-picked set of categories for the homepage preview
const previewCategoryNames = [
  'Homemade Appetizers',
  'Signature Shrimp Dishes',
  "Po' Boys & Sandwiches",
  "Papa's Signature Drinks",
  'Desserts & Ice Cream',
];

const categories = previewCategoryNames
  .map((name) => menuData.categories.find((c) => c.name === name))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const ITEMS_SHOWN = 4;

function formatPrice(price: string) {
  if (price === 'Market Price') return 'MKT';
  if (price.includes('/')) {
    return price
      .split('/')
      .map((p) => `$${p.trim()}`)
      .join(' / ');
  }
  return `$${price}`;
}
---

<div class="max-w-3xl mx-auto">
  <div class="space-y-3">
    {categories.map((category, i) => (
      <details class="menu-accordion-item group rounded-2xl bg-white shadow-sm border border-brand-sand overflow-hidden" open={i === 0}>
        <summary class="flex items-center justify-between gap-4 px-5 sm:px-7 py-5 cursor-pointer select-none hover:bg-brand-cream/60 transition-colors">
          <div class="flex items-center gap-4">
            <span class="hidden sm:flex w-11 h-11 rounded-full bg-brand-teal/10 text-brand-teal items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18M3 17h18" />
              </svg>
            </span>
            <div>
              <h3 class="font-display text-lg sm:text-xl font-bold text-brand-navy">{category.name}</h3>
              <p class="text-gray-400 text-xs sm:text-sm mt-0.5">{category.description}</p>
            </div>
          </div>
          <svg class="menu-accordion-chevron w-5 h-5 text-brand-red flex-shrink-0 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>

        <div class="menu-accordion-panel border-t border-brand-sand px-5 sm:px-7 py-2">
          <ul class="divide-y divide-brand-sand/70" role="list">
            {category.items.slice(0, ITEMS_SHOWN).map((item) => (
              <li class="flex justify-between items-start gap-4 py-3.5">
                <div class="flex-1">
                  <p class="font-display font-bold text-brand-navy text-sm sm:text-base">{item.name}</p>
                  <p class="text-gray-400 text-xs sm:text-sm mt-1 leading-relaxed line-clamp-2">{item.description}</p>
                </div>
                <p class="text-brand-red font-display font-bold text-sm sm:text-base whitespace-nowrap pt-0.5">
                  {formatPrice(item.price)}
                </p>
              </li>
            ))}
          </ul>
          {category.items.length > ITEMS_SHOWN && (
            <p class="text-xs text-gray-400 pt-1 pb-4">
              + {category.items.length - ITEMS_SHOWN} more on the full menu
            </p>
          )}
        </div>
      </details>
    ))}
  </div>

  <div class="text-center mt-10">
    <a href="/menu" class="btn-primary px-8 py-3.5">View Full Menu</a>
  </div>
</div>
